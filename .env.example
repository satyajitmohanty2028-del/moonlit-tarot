# Copy to .env.local for local development. Never commit real keys.
# With no keys set, the app runs in clearly labelled demo mode (built-in card meanings).

# Primary AI provider: Google Gemini API free tier. Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.5-flash-lite).
GEMINI_MODEL=

# Optional alternative provider (paid), used only when GEMINI_API_KEY is not set.
ANTHROPIC_API_KEY=
# Optional: override the Anthropic model (default: claude-haiku-4-5).
ANTHROPIC_MODEL=

# Optional: AI readings allowed per visitor IP per hour (default: 5).
AI_READINGS_PER_HOUR=
